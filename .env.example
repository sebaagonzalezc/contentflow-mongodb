# Copiar este archivo como .env y completar. El archivo .env NO se sube al repo.
# String de conexion de Atlas (Connect > Drivers). Reemplazar <usuario> y <password>.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=ContentFlowCluster
MONGODB_DB=contentflow
MONGODB_TIMEOUT_MS=5000
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
